// Landing page for https://knowgauge.com: Cloudflare Workers static assets (public/) plus a tiny Worker
// (src/worker.js) that stores beta waitlist sign-ups (POST /api/notify) in the WAITLIST KV namespace.
// Deploy from this folder: npx wrangler@4 deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowgauge-landing",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; pages and images are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Created with: npx wrangler@4 kv namespace create WAITLIST
    { "binding": "WAITLIST", "id": "0656aa1c665740898d03402b01e5d566" }
  ],
  "routes": [
    { "pattern": "knowgauge.com", "custom_domain": true },
    { "pattern": "www.knowgauge.com", "custom_domain": true }
  ],
  "workers_dev": false
}
