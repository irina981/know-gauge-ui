server {
    listen 80;
    root /usr/share/nginx/html;

    # Backend API. Ingestion and test generation are synchronous and can take minutes.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        client_max_body_size 50m;
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # nginx's MIME list has no .mjs, and browsers only start the PDF.js worker (a module) when it is served as
        # JavaScript. A types block replaces the whole list, so it is limited to .mjs files here.
        location ~* \.mjs$ {
            types { text/javascript mjs; }
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Single-page app: unknown paths (e.g. /tests/12) return index.html and React Router takes over.
    location / {
        try_files $uri /index.html;
    }
}
